# Modele du fichier .env (secrets locaux, jamais commite).
# Copier ce fichier en .env, a la racine du depot, puis remplir les valeurs.
# Valeurs entre apostrophes : PI_MOT_DE_PASSE='...'

# Raspberry Pi Zero 2W
PI_HOTE=
PI_UTILISATEUR=
PI_MOT_DE_PASSE=
PI_SSH=

# Module 4G SIM7600 (lu par tableau_bord sur la Pi, au demarrage)
# Numeros de l'equipe, separes par des virgules : seuls ces numeros peuvent
# envoyer des commandes ou des messages au bateau, et ce sont eux qui
# recevront les SMS envoyes par le bateau. Ex. : SIM_NUMEROS='+33612345678,0698765432'
SIM_NUMEROS=
# Code PIN de la carte SIM (vide si la carte n'en demande pas).
# Essaye une seule fois par demarrage du module : un code faux ne bloque pas la carte.
SIM_PIN=
