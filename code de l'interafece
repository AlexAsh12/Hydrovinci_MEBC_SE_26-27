# ----- Bouton Quitter (cliquable) -----
def quit_app():
    root.destroy()

btn_quit = tk.Button(
    frame_msg,
    text="QUITTER",
    command=quit_app,
    font=("DejaVu Sans", 16, "bold"),
    bg="#7f1d1d",
    fg="white",
    padx=20,
    pady=10
)
btn_quit.pack(anchor="e", pady=(10, 0))

# ----- Lecture fichier température -----
# Format attendu de la dernière ligne :
# "YYYY-MM-DD HH:MM:SS;tempC;tempF"
TEMP_FILE = "/home/sudo/HydroVinci/Captation/recuptemp"

def read_temp_from_file(path):
    try:
        with open(path, "r") as f:
            lines = f.read().splitlines()

        # enlève les lignes vides
        lines = [ln.strip() for ln in lines if ln.strip()]
        if not lines:
            return None, None, "Fichier vide"

        last = lines[-1]
        parts = last.split(";")
        if len(parts) < 3:
            return None, None, f"Format invalide: {last}"

        temp_c = float(parts[1])
        temp_f = float(parts[2])
        return temp_c, temp_f, "OK"

    except FileNotFoundError:
        return None, None, f"Introuvable: {path}"
    except Exception as e:
        return None, None, f"Erreur lecture: {e}"

def update_ui():
    temp_c, temp_f, status = read_temp_from_file(TEMP_FILE)

    if temp_c is None:
        temp.set("Temp sonde : --.- °C / --.- °F")
        lbl_temp.config(fg="white")
        msg_text.set(f"💬 Temp: {status}")
        ai_text.set("🟠 En attente des données…")
    else:
        temp.set(f"Temp sonde : {temp_c:.1f} °C / {temp_f:.1f} °F")
        msg_text.set("💬 Capteur température OK")

        # Couleur selon température (en °C)
        if temp_c > 28:
            lbl_temp.config(fg="red")
        elif temp_c >= 26:
            lbl_temp.config(fg="orange")
        else:
            lbl_temp.config(fg="green")

        ai_text.set("🟢 Température reçue")

    # (Pour l’instant vitesse/cap pas branchés)
    speed.set("Vitesse : --.- kn")
    heading.set("Cap : ---°")

    root.after(1000, update_ui)  # refresh toutes les 1s

update_ui()
root.mainloop()
